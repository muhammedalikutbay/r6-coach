{
  "name": "accept-replay-dir",
  "description": "Acceptance for r6k-rxr.3. Needs USE_MOCK=false in app/src/lib/api.ts and an existing empty folder %LOCALAPPDATA%/Temp/r6k-empty-dir. The native folder dialog cannot be automated, so set_replay_dir is called through invoke, which is what the dialog result feeds into.",
  "steps": [
    {
      "type": "localStorage.clear"
    },
    {
      "type": "reload"
    },
    {
      "type": "wait",
      "text": "Let's go",
      "timeout": 30000
    },
    {
      "type": "click",
      "text": "Let's go"
    },
    {
      "type": "eval",
      "expr": "Promise.resolve(window.__TAURI_INTERNALS__.invoke('set_replay_dir', { path: '${R6K_EMPTY_DIR}' })).then(() => 'saved')",
      "expect": "saved"
    },
    {
      "type": "reload"
    },
    {
      "type": "click",
      "text": "Settings"
    },
    {
      "type": "wait",
      "text": "No matches found in this folder",
      "timeout": 15000
    },
    {
      "type": "eval",
      "expr": "document.body.innerText.includes('\"Match Replay\"') && document.body.innerText.includes('r6k-empty-dir')",
      "expect": true
    },
    {
      "type": "screenshot",
      "path": "replay-dir-empty.png"
    },
    {
      "type": "eval",
      "expr": "Promise.resolve(window.__TAURI_INTERNALS__.invoke('set_replay_dir', { path: '${R6K_REPLAY_DIR}' })).then(() => 'saved')",
      "expect": "saved"
    },
    {
      "type": "reload"
    },
    {
      "type": "click",
      "text": "Settings"
    },
    {
      "type": "wait",
      "text": "30 matches found",
      "timeout": 15000
    },
    {
      "type": "eval",
      "expr": "!document.body.innerText.includes('No matches found')",
      "expect": true
    },
    {
      "type": "screenshot",
      "path": "replay-dir-ready.png"
    }
  ]
}
