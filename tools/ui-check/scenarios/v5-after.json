{
  "name": "v5-after",
  "description": "v5 UI fixes: runs against a data folder given by R6COACH_DATA_DIR. Screens at 1440x900 and 1100x720.",
  "steps": [
    { "type": "localStorage.clear" },
    { "type": "reload" },
    { "type": "wait", "text": "Let's go", "timeout": 60000 },
    { "type": "click", "text": "Let's go" },
    { "type": "viewport", "width": 1424, "height": 861 },
    { "type": "eval", "expr": "document.querySelector('a[href=\"/overview\"]').click()" },
    { "type": "wait", "text": "Recent matches", "timeout": 30000 },
    { "type": "sleep", "ms": 1500 },
    { "type": "screenshot", "path": "${R6K_SHOTS_DIR}/1440-overview.png" },
    { "type": "eval", "expr": "[...document.querySelectorAll('main *')].filter(e=>e.children.length===0 && /\\b1 (rounds|kills|deaths|matches)\\b/.test(e.textContent)).map(e=>e.textContent.trim())" },
    { "type": "eval", "expr": "document.querySelector('main').scrollTo(0, 3000); document.querySelector('a[href=\"/operators\"]').click()" },
    { "type": "wait", "text": "Kills / round", "timeout": 15000 },
    { "type": "sleep", "ms": 800 },
    { "type": "eval", "expr": "document.querySelector('main').scrollTop", "expect": 0 },
    { "type": "screenshot", "path": "${R6K_SHOTS_DIR}/1440-operators.png" },
    { "type": "eval", "expr": "document.querySelector('a[href=\"/weapons\"]').click()" },
    { "type": "wait", "text": "Share of kills", "timeout": 15000 },
    { "type": "sleep", "ms": 800 },
    { "type": "screenshot", "path": "${R6K_SHOTS_DIR}/1440-weapons.png" },
    { "type": "eval", "expr": "[...document.querySelectorAll('tbody tr')].map(r=>r.querySelector('td').textContent.trim()+'|'+r.children[1].textContent.trim())" },
    { "type": "eval", "expr": "document.querySelector('a[href=\"/operators\"]').click()" },
    { "type": "wait", "text": "Kills / round", "timeout": 15000 },
    { "type": "eval", "expr": "document.querySelector('tbody a[href^=\"/operators/\"]').click()" },
    { "type": "wait", "text": "Matches played with", "timeout": 20000 },
    { "type": "sleep", "ms": 1000 },
    { "type": "screenshot", "path": "${R6K_SHOTS_DIR}/1440-operator-noor.png" },
    { "type": "eval", "expr": "[...document.querySelectorAll('a[href^=\"/matches?match=\"]')].length > 0", "expect": true },
    { "type": "eval", "expr": "document.querySelector('a[href^=\"/matches?match=\"]').click()" },
    { "type": "wait", "text": "Match detail", "timeout": 20000 },
    { "type": "sleep", "ms": 1000 },
    { "type": "screenshot", "path": "${R6K_SHOTS_DIR}/1440-match-from-operator.png" },
    { "type": "click", "text": "Rounds" },
    { "type": "sleep", "ms": 800 },
    { "type": "screenshot", "path": "${R6K_SHOTS_DIR}/1440-match-rounds.png" },
    { "type": "eval", "expr": "location.assign('/coach')" },
    { "type": "wait", "text": "Comparison", "timeout": 30000 },
    { "type": "sleep", "ms": 800 },
    { "type": "screenshot", "path": "${R6K_SHOTS_DIR}/1440-coach.png" },
    { "type": "eval", "expr": "location.assign('/home')" },
    { "type": "sleep", "ms": 2500 },
    { "type": "screenshot", "path": "${R6K_SHOTS_DIR}/1440-home.png" },
    { "type": "viewport", "width": 1084, "height": 681 },
    { "type": "eval", "expr": "document.querySelector('a[href=\"/overview\"]').click()" },
    { "type": "wait", "text": "Recent matches", "timeout": 30000 },
    { "type": "sleep", "ms": 800 },
    { "type": "eval", "expr": "document.querySelector('header').getBoundingClientRect().height < 64", "expect": true },
    { "type": "screenshot", "path": "${R6K_SHOTS_DIR}/1100-overview.png" },
    { "type": "eval", "expr": "document.querySelector('a[href=\"/weapons\"]').click()" },
    { "type": "wait", "text": "Share of kills", "timeout": 15000 },
    { "type": "sleep", "ms": 800 },
    { "type": "eval", "expr": "document.querySelector('header').getBoundingClientRect().height < 64", "expect": true },
    { "type": "screenshot", "path": "${R6K_SHOTS_DIR}/1100-weapons.png" },
    { "type": "eval", "expr": "document.querySelector('a[href=\"/coach\"]').click()" },
    { "type": "wait", "text": "Comparison", "timeout": 30000 },
    { "type": "eval", "expr": "document.querySelector('header').getBoundingClientRect().height < 64", "expect": true },
    { "type": "screenshot", "path": "${R6K_SHOTS_DIR}/1100-coach.png" },
    { "type": "viewport", "width": 0 }
  ]
}
