{
  "name": "install-real-data",
  "description": "Acceptance for r6k-rxr.6. Run against the INSTALLED exe (--exe the installed r6koc-app.exe): reset the database, set the replay folder through invoke, press Update, wait for a real map and check that the sidecar was found.",
  "steps": [
    { "type": "localStorage.clear" },
    { "type": "reload" },
    { "type": "wait", "text": "Let's go", "timeout": 30000 },
    { "type": "click", "text": "Let's go" },
    { "type": "eval", "expr": "Promise.resolve(window.__TAURI_INTERNALS__.invoke('reset_database')).then(() => 'reset')", "expect": "reset" },
    { "type": "eval", "expr": "Promise.resolve(window.__TAURI_INTERNALS__.invoke('set_replay_dir', { path: '${R6K_REPLAY_DIR}' })).then(() => 'saved')", "expect": "saved" },
    { "type": "reload" },
    { "type": "wait", "text": "No matches yet", "timeout": 15000 },
    { "type": "click", "text": "Update" },
    { "type": "wait", "text": "Outback", "timeout": 300000 },
    { "type": "wait", "text": "This session", "timeout": 15000 },
    { "type": "eval", "expr": "document.body.innerText.includes('30 new matches added')", "expect": true },
    { "type": "eval", "expr": "!/sidecar not found/i.test(document.body.innerText)", "expect": true },
    { "type": "eval", "expr": "document.querySelectorAll('ul.advice li').length > 2", "expect": true },
    { "type": "eval", "expr": "/31 Oct,? 00:5\\d/.test(document.body.innerText)", "expect": true },
    { "type": "click", "text": "Operators" },
    { "type": "wait", "text": "Rook", "timeout": 15000 },
    { "type": "screenshot", "path": "install-operators.png" },
    { "type": "click", "text": "Maps" },
    { "type": "wait", "text": "Bank", "timeout": 15000 },
    { "type": "screenshot", "path": "install-maps.png" },
    { "type": "click", "text": "Home" },
    { "type": "wait", "text": "This session", "timeout": 15000 },
    { "type": "screenshot", "path": "install-home.png" }
  ]
}
